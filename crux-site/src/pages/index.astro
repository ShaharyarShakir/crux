---
// index.astro — Custom Crux Homepage
import BaseLayout from '../components/BaseLayout.astro';
import CopyCommand from '../components/CopyCommand.astro';
import Terminal from '../components/Terminal.astro';
import FeatureSection from '../components/FeatureSection.astro';
import WorkflowSection from '../components/WorkflowSection.astro';
import CodeExample from '../components/CodeExample.astro';
---

<BaseLayout
  title="Crux — Source-First C/C++ Package Manager"
  description="Deterministic, single-version ODR-safe package manager for C and C++ written in Rust with native CMake integration."
>
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="crux-container hero-container">
      <div class="hero-badge-wrapper">
        <a href="/crux/project/changelog/" class="crux-badge">
          <span>v0.2.1 Hotfix Released</span>
          <svg viewBox="0 0 20 20" width="14" height="14" fill="currentColor">
            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
          </svg>
        </a>
      </div>

      <h1 class="hero-title">
        Deterministic package management for <span class="highlight">C and C++</span>.
      </h1>

      <p class="hero-description">
        Crux is a source-first package manager written in Rust. It strictly enforces single-version
        ODR invariants, manages catalogs via standard Git repositories, verifies cryptographic
        checksums, and generates native, relocatable CMake integration.
      </p>

      <div class="hero-actions">
        <a href="/crux/guides/getting-started/" class="crux-btn crux-btn-primary">
          Get Started
          <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor">
            <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </a>
        <a href="/crux/reference/cli/" class="crux-btn crux-btn-secondary">
          CLI Reference
        </a>
        <a
          href="https://github.com/ShaharyarShakir/crux"
          class="crux-btn crux-btn-ghost"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
          </svg>
          GitHub
        </a>
      </div>

      <!-- Quick Install Bar -->
      <div class="hero-install">
        <CopyCommand />
      </div>

      <!-- Terminal Mockup -->
      <div class="hero-terminal">
        <Terminal />
      </div>
    </div>
  </section>

  <!-- Key Architectural Pillars Banner -->
  <section class="pillars-banner">
    <div class="crux-container">
      <div class="pillars-grid">
        <div class="pillar-item">
          <span class="pillar-stat">ODR Safe</span>
          <span class="pillar-label">Single-version invariant guarantees zero duplicate symbol collisions</span>
        </div>
        <div class="pillar-item">
          <span class="pillar-stat">GitOps Native</span>
          <span class="pillar-label">Decentralized catalogs backed by standard Git repositories</span>
        </div>
        <div class="pillar-item">
          <span class="pillar-stat">SHA-256</span>
          <span class="pillar-label">Streaming cryptographic integrity and Zip Slip extraction defenses</span>
        </div>
        <div class="pillar-item">
          <span class="pillar-stat">CMake First</span>
          <span class="pillar-label">Emits relocatable CruxDependencies.cmake with native target exports</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <FeatureSection />

  <!-- How It Works Section -->
  <WorkflowSection />

  <!-- Code Showcase Section -->
  <CodeExample />

  <!-- Ready to Build CTA Section -->
  <section class="cta-section">
    <div class="crux-container">
      <div class="cta-card">
        <span class="crux-badge">v0.2.1 Hotfix</span>
        <h2 class="cta-title">Ready to take control of your C/C++ dependencies?</h2>
        <p class="cta-description">
          Install the Crux v0.2.1 hotfix binary in seconds, explore the seed registry, and integrate
          reproducible dependencies into your CMake build tree.
        </p>
        <div class="cta-install-bar">
          <CopyCommand />
        </div>
        <div class="cta-actions">
          <a href="/crux/guides/getting-started/" class="crux-btn crux-btn-primary">
            Read Getting Started Guide
          </a>
          <a href="/crux/design/architecture/" class="crux-btn crux-btn-secondary">
            Inspect Architecture Specification
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero Section */
  .hero-section {
    padding-top: 5rem;
    padding-bottom: 4rem;
    text-align: center;
    background-color: var(--crux-bg);
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 960px;
  }

  .hero-badge-wrapper {
    margin-bottom: 1.5rem;
  }

  .hero-badge-wrapper a {
    text-decoration: none;
    transition: transform 0.15s ease;
  }

  .hero-badge-wrapper a:hover {
    transform: translateY(-1px);
  }

  .hero-title {
    font-size: 3.5rem;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.04em;
    color: var(--crux-text-primary);
    margin: 0 0 1.5rem 0;
    max-width: 820px;
  }

  .hero-title .highlight {
    color: var(--crux-accent);
  }

  .hero-description {
    font-size: 1.25rem;
    color: var(--crux-text-secondary);
    line-height: 1.6;
    max-width: 720px;
    margin: 0 0 2rem 0;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
  }

  .hero-install {
    margin-bottom: 3.5rem;
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .hero-terminal {
    width: 100%;
    max-width: 820px;
    margin: 0 auto;
  }

  /* Pillars Banner */
  .pillars-banner {
    border-top: 1px solid var(--crux-border);
    border-bottom: 1px solid var(--crux-border);
    background-color: var(--crux-surface-subtle);
    padding: 2.5rem 0;
  }

  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }

  .pillar-item {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .pillar-stat {
    font-family: var(--crux-font-mono);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--crux-accent);
    letter-spacing: -0.02em;
  }

  .pillar-label {
    font-size: 0.84rem;
    color: var(--crux-text-secondary);
    line-height: 1.5;
  }

  /* CTA Section */
  .cta-section {
    padding: 6rem 0;
    background-color: var(--crux-bg);
  }

  .cta-card {
    background-color: var(--crux-surface);
    border: 1px solid var(--crux-border);
    border-radius: var(--crux-radius-lg);
    padding: 3.5rem 2rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 860px;
    margin: 0 auto;
  }

  .cta-title {
    font-size: 2.25rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--crux-text-primary);
    margin: 1rem 0 1rem 0;
    max-width: 640px;
    line-height: 1.25;
  }

  .cta-description {
    font-size: 1.0625rem;
    color: var(--crux-text-secondary);
    line-height: 1.6;
    max-width: 600px;
    margin: 0 0 2rem 0;
  }

  .cta-install-bar {
    margin-bottom: 2rem;
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .cta-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  @media (max-width: 900px) {
    .hero-title {
      font-size: 2.5rem;
    }
    .hero-description {
      font-size: 1.1rem;
    }
    .pillars-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .hero-title {
      font-size: 2rem;
    }
    .pillars-grid {
      grid-template-columns: 1fr;
    }
    .cta-card {
      padding: 2.5rem 1.25rem;
    }
    .cta-title {
      font-size: 1.625rem;
    }
  }
</style>
