---
// Terminal.astro — Developer terminal window mockup
interface Props {
  title?: string;
}

const { title = 'bash — crux v0.1.0' } = Astro.props;
---

<div class="terminal-window">
  <div class="terminal-header">
    <div class="terminal-dots">
      <span class="dot close"></span>
      <span class="dot minimize"></span>
      <span class="dot expand"></span>
    </div>
    <div class="terminal-title">{title}</div>
    <div class="terminal-actions">
      <span class="terminal-badge">crux-cli</span>
    </div>
  </div>

  <div class="terminal-body">
    <pre class="terminal-code"><code><span class="line-cmd"><span class="prompt">$</span> crux init my_service --lang cpp</span>
<span class="line-out">Created package 'my_service' (0.1.0)</span>
<span class="line-out">Generated crux.toml and src/main.cpp</span>

<span class="line-cmd"><span class="prompt">$</span> crux check</span>
<span class="line-out">Analyzing crux.toml...</span>
<span class="line-out">Dependencies: fmt (>=11.0.0, &lt;12.0.0)</span>
<span class="line-success">&#10003; Manifest validation successful</span>

<span class="line-cmd"><span class="prompt">$</span> crux lock</span>
<span class="line-out">Solving dependency graph...</span>
<span class="line-out">Resolved 1 package in 28ms</span>
<span class="line-highlight">[ODR Verification] Invariant satisfied: 0 duplicate symbol collisions</span>
<span class="line-out">Wrote crux.lock (canonical SHA-256 digest)</span>

<span class="line-cmd"><span class="prompt">$</span> crux install fmt</span>
<span class="line-out">Acquiring fmt 11.1.1 (streaming HTTP download)...</span>
<span class="line-success">&#10003; SHA-256 checksum verified</span>
<span class="line-out">Building via CMake (Release)...</span>
<span class="line-out">Staging artifacts to .crux/store/fmt/11.1.1...</span>
<span class="line-success">&#10003; Atomic publication complete</span>

<span class="line-cmd"><span class="prompt">$</span> crux integrate cmake</span>
<span class="line-out">Validating package installations...</span>
<span class="line-success">&#10003; Generated .crux/cmake/CruxDependencies.cmake</span></code></pre>
  </div>
</div>

<style>
  .terminal-window {
    width: 100%;
    border-radius: var(--crux-radius-lg);
    border: 1px solid var(--crux-border);
    background-color: var(--crux-terminal-bg);
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.45);
    overflow: hidden;
  }

  .terminal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.65rem 1rem;
    background-color: var(--crux-surface);
    border-bottom: 1px solid var(--crux-border);
  }

  .terminal-dots {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
  }

  .dot.close { background-color: #E25C51; }
  .dot.minimize { background-color: #E0AC3C; }
  .dot.expand { background-color: #4CAF50; }

  .terminal-title {
    font-family: var(--crux-font-mono);
    font-size: 0.75rem;
    color: var(--crux-text-muted);
    letter-spacing: 0.02em;
  }

  .terminal-badge {
    font-family: var(--crux-font-mono);
    font-size: 0.6875rem;
    color: var(--crux-accent);
    background-color: var(--crux-accent-dim);
    padding: 0.1rem 0.45rem;
    border-radius: var(--crux-radius-sm);
    border: 1px solid var(--crux-accent-border);
  }

  .terminal-body {
    padding: 1.25rem 1.5rem;
    overflow-x: auto;
  }

  .terminal-code {
    margin: 0;
    padding: 0;
    font-family: var(--crux-font-mono);
    font-size: 0.84rem;
    line-height: 1.6;
    color: var(--crux-text-secondary);
    background: transparent;
  }

  .line-cmd {
    display: block;
    color: var(--crux-accent);
    font-weight: 600;
    margin-top: 0.5rem;
  }

  .line-cmd:first-child {
    margin-top: 0;
  }

  .prompt {
    color: var(--crux-text-muted);
    user-select: none;
    margin-right: 0.4rem;
  }

  .line-out {
    display: block;
    color: var(--crux-text-secondary);
  }

  .line-success {
    display: block;
    color: #5BA882;
  }

  .line-highlight {
    display: block;
    color: #B3D1E4;
  }

  @media (max-width: 640px) {
    .terminal-body {
      padding: 1rem;
    }
    .terminal-code {
      font-size: 0.75rem;
    }
  }
</style>
