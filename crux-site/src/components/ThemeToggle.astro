---
// ThemeToggle.astro — Accessible dark/light theme switch
---

<button id="crux-theme-toggle" class="theme-toggle" aria-label="Toggle color theme" type="button">
  <svg class="sun-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2"></path>
    <path d="M12 20v2"></path>
    <path d="m4.93 4.93 1.41 1.41"></path>
    <path d="m17.66 17.66 1.41 1.41"></path>
    <path d="M2 12h2"></path>
    <path d="M20 12h2"></path>
    <path d="m6.34 17.66-1.41 1.41"></path>
    <path d="m19.07 4.93-1.41 1.41"></path>
  </svg>
  <svg class="moon-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--crux-radius-sm);
    border: 1px solid var(--crux-border);
    background: var(--crux-surface);
    color: var(--crux-text-secondary);
    cursor: pointer;
    transition: all 0.15s ease;
    padding: 0;
  }

  .theme-toggle:hover {
    color: var(--crux-accent);
    border-color: var(--crux-accent);
    background: var(--crux-surface-elevated);
  }

  /* Show sun in dark mode, moon in light mode */
  :global([data-theme="dark"]) .sun-icon {
    display: block;
  }
  :global([data-theme="dark"]) .moon-icon {
    display: none;
  }

  :global([data-theme="light"]) .sun-icon {
    display: none;
  }
  :global([data-theme="light"]) .moon-icon {
    display: block;
  }
</style>

<script is:inline>
  (() => {
    const toggle = document.getElementById('crux-theme-toggle');
    if (!toggle) return;

    toggle.addEventListener('click', () => {
      const current = document.documentElement.dataset.theme || 'dark';
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      localStorage.setItem('starlight-theme', next);
    });
  })();
</script>
