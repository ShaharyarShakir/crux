---
// SiteFooter.astro — Global footer
import { Image } from 'astro:assets';
import cruxLogo from '../assets/crux-logo.png';
---

<footer class="crux-footer">
  <div class="crux-container footer-inner">
    <div class="footer-grid">
      <!-- Column 1: Brand & Identity -->
      <div class="footer-col brand-col">
        <div class="footer-brand">
          <Image src={cruxLogo} alt="Crux Logo" width={28} height={28} class="footer-logo" />
          <span class="footer-name">Crux</span>
          <span class="footer-version">v0.1.0</span>
        </div>
        <p class="footer-tagline">
          Source-first, deterministic package manager for C and C++ written in Rust.
        </p>
        <p class="footer-license">
          Open-source software licensed under the <a href="https://github.com/ShaharyarShakir/crux/blob/main/LICENSE" target="_blank" rel="noopener noreferrer">MIT License</a>.
        </p>
      </div>

      <!-- Column 2: Documentation -->
      <div class="footer-col">
        <h4 class="footer-heading">Documentation</h4>
        <ul class="footer-links">
          <li><a href="/crux/guides/getting-started/">Getting Started</a></li>
          <li><a href="/crux/guides/installation/">Installation Guide</a></li>
          <li><a href="/crux/reference/cli/">CLI Reference</a></li>
          <li><a href="/crux/registry/packages/">Seed Packages</a></li>
        </ul>
      </div>

      <!-- Column 3: Architecture -->
      <div class="footer-col">
        <h4 class="footer-heading">Architecture</h4>
        <ul class="footer-links">
          <li><a href="/crux/design/architecture/">Architecture Overview</a></li>
          <li><a href="/crux/design/security/">Security Model</a></li>
          <li><a href="/crux/design/architecture/#single-version-policy-and-odr-safety">Single-Version ODR Safety</a></li>
          <li><a href="/crux/design/architecture/#consumer-integration-subsystem-integrate">CMake Integration</a></li>
        </ul>
      </div>

      <!-- Column 4: Project -->
      <div class="footer-col">
        <h4 class="footer-heading">Project</h4>
        <ul class="footer-links">
          <li><a href="https://github.com/ShaharyarShakir/crux" target="_blank" rel="noopener noreferrer">GitHub Repository</a></li>
          <li><a href="https://github.com/ShaharyarShakir/crux/releases" target="_blank" rel="noopener noreferrer">Releases (v0.1.0)</a></li>
          <li><a href="/crux/project/roadmap/">Project Roadmap</a></li>
          <li><a href="/crux/project/changelog/">Changelog</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="footer-copyright">
        © 2026 Crux Contributors. Built for reliable, deterministic C and C++ software engineering.
      </p>
      <div class="footer-badges">
        <span class="status-indicator"></span>
        <span class="status-text">Production Ready v0.1.0</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .crux-footer {
    border-top: 1px solid var(--crux-border);
    background-color: var(--crux-surface-subtle);
    padding-top: 3.5rem;
    padding-bottom: 2.5rem;
    margin-top: 4rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 2.5rem;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .brand-col {
    padding-right: 1.5rem;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .footer-logo {
    display: block;
    width: 24px;
    height: 24px;
  }

  .footer-name {
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--crux-text-primary);
  }

  .footer-version {
    font-family: var(--crux-font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    padding: 0.1rem 0.4rem;
    border-radius: var(--crux-radius-sm);
    background-color: var(--crux-accent-dim);
    color: var(--crux-accent);
    border: 1px solid var(--crux-accent-border);
  }

  .footer-tagline {
    font-size: 0.875rem;
    color: var(--crux-text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  .footer-license {
    font-size: 0.8125rem;
    color: var(--crux-text-muted);
    margin: 0;
  }

  .footer-heading {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--crux-text-primary);
    margin: 0 0 0.5rem 0;
  }

  .footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-links a {
    font-size: 0.875rem;
    color: var(--crux-text-secondary);
    transition: color 0.15s ease;
  }

  .footer-links a:hover {
    color: var(--crux-accent);
  }

  .footer-bottom {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--crux-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer-copyright {
    font-size: 0.8125rem;
    color: var(--crux-text-muted);
    margin: 0;
  }

  .footer-badges {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--crux-font-mono);
    font-size: 0.75rem;
    color: var(--crux-text-secondary);
  }

  .status-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #5BA882;
    box-shadow: 0 0 6px rgba(91, 168, 130, 0.5);
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
    .brand-col {
      grid-column: span 2;
    }
  }

  @media (max-width: 600px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
    .brand-col {
      grid-column: span 1;
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
