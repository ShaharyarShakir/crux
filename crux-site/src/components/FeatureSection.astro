---
// FeatureSection.astro — Editorial grid highlighting Crux's 6 core engineering capabilities
const features = [
  {
    tag: 'ODR Invariant',
    title: 'Strict Single-Version Policy',
    subtitle: 'ODR safety across static & shared libraries',
    description:
      'In C and C++, linking multiple versions of the same library leads to symbol collisions, binary bloat, and One Definition Rule (ODR) violations. Crux’s resolver enforces a strict single-version invariant across the entire resolved graph, attributing conflicting constraints with clear diagnostic blame.',
    link: '/crux/design/architecture/#single-version-policy-and-odr-safety'
  },
  {
    tag: 'GitOps Native',
    title: 'Git-Backed Registries',
    subtitle: 'Branchable, transparent, decentralized metadata',
    description:
      'Package definitions are version-controlled in standard Git repositories using human-readable TOML files. Audit, branch, pin, or host private enterprise registries using standard Git infrastructure with zero proprietary server dependencies.',
    link: '/crux/design/architecture/#registry-index-subsystem-registry'
  },
  {
    tag: 'Cryptographic Integrity',
    title: 'Streaming & Verified Acquisition',
    subtitle: 'Mandatory SHA-256 digests & decompression guards',
    description:
      'HTTP and HTTPS streaming acquisition computes SHA-256 digests in real time without buffering entire archives in RAM. Archive extractors enforce strict Zip Slip directory traversal prevention and decompression bomb limits.',
    link: '/crux/design/security/'
  },
  {
    tag: 'Hermetic Engine',
    title: 'CMake Build Engine',
    subtitle: 'Out-of-source configuration & compiler detection',
    description:
      'Crux inspects local C and C++ compilers, determines toolchain capabilities, and executes CMake in isolated build directories. Deterministic build fingerprints ensure cached artifacts are reused safely without stale state.',
    link: '/crux/design/architecture/#build-system-subsystem-build'
  },
  {
    tag: 'Atomic Storage',
    title: 'Staged Publication',
    subtitle: 'Corrupt-free package installation lifecycle',
    description:
      'Artifacts are installed into temporary staging directories, verified for header and library inventories, and atomically published into content-addressed stores. A failing build or power interruption never leaves half-installed packages.',
    link: '/crux/design/architecture/#package-installation-subsystem-install'
  },
  {
    tag: 'Native Tooling',
    title: 'Relocatable CMake Integration',
    subtitle: 'Standard find_package & target exports',
    description:
      'The integrate engine produces a self-contained CruxDependencies.cmake file. Consumer CMake projects simply include it and link targets normally with target_link_libraries(app PRIVATE fmt::fmt), without modifying compiler flags manually.',
    link: '/crux/design/architecture/#consumer-integration-subsystem-integrate'
  }
];
---

<section class="features-section" id="features">
  <div class="crux-container">
    <div class="section-header">
      <span class="crux-badge">Architecture & Design</span>
      <h2 class="section-title">Engineered for the realities of C and C++</h2>
      <p class="section-subtitle">
        Crux doesn't treat native binaries like interpreted packages. It respects the compiler, linker, ABI, and One Definition Rule from first principles.
      </p>
    </div>

    <div class="features-grid">
      {features.map((feature) => (
        <div class="feature-card">
          <div class="card-header">
            <span class="feature-tag">{feature.tag}</span>
          </div>
          <h3 class="feature-title">{feature.title}</h3>
          <h4 class="feature-subtitle">{feature.subtitle}</h4>
          <p class="feature-desc">{feature.description}</p>
          <div class="card-footer">
            <a href={feature.link} class="card-link">
              Read architectural design
              <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor">
                <path fill-rule="evenodd" d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .features-section {
    padding-top: 5rem;
    padding-bottom: 5rem;
    border-top: 1px solid var(--crux-border);
    background-color: var(--crux-bg);
  }

  .section-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 3.5rem auto;
  }

  .section-title {
    font-size: 2.25rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--crux-text-primary);
    margin-top: 0.75rem;
    margin-bottom: 1rem;
    line-height: 1.25;
  }

  .section-subtitle {
    font-size: 1.0625rem;
    color: var(--crux-text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .feature-card {
    background-color: var(--crux-surface);
    border: 1px solid var(--crux-border);
    border-radius: var(--crux-radius-lg);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }

  .feature-card:hover {
    border-color: var(--crux-accent-border);
    transform: translateY(-2px);
  }

  .card-header {
    margin-bottom: 1rem;
  }

  .feature-tag {
    font-family: var(--crux-font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--crux-accent);
    background-color: var(--crux-accent-dim);
    border: 1px solid var(--crux-accent-border);
    padding: 0.15rem 0.5rem;
    border-radius: var(--crux-radius-sm);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .feature-title {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--crux-text-primary);
    margin: 0 0 0.35rem 0;
  }

  .feature-subtitle {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--crux-accent);
    margin: 0 0 1rem 0;
    line-height: 1.4;
  }

  .feature-desc {
    font-size: 0.9375rem;
    color: var(--crux-text-secondary);
    line-height: 1.6;
    margin: 0 0 1.5rem 0;
    flex-grow: 1;
  }

  .card-footer {
    border-top: 1px solid var(--crux-border-subtle);
    padding-top: 1rem;
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--crux-accent);
    text-decoration: none;
    transition: gap 0.15s ease;
  }

  .card-link:hover {
    color: var(--crux-accent-hover);
    gap: 0.6rem;
  }

  @media (max-width: 1024px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 680px) {
    .features-grid {
      grid-template-columns: 1fr;
    }
    .section-title {
      font-size: 1.75rem;
    }
  }
</style>
