---
// SiteHeader.astro — Global header navigation
import ThemeToggle from './ThemeToggle.astro';
import { Image } from 'astro:assets';
import cruxLogo from '../assets/crux-logo.png';

const navLinks = [
  { label: 'Getting Started', href: '/crux/guides/getting-started/' },
  { label: 'Installation', href: '/crux/guides/installation/' },
  { label: 'CLI Reference', href: '/crux/reference/cli/' },
  { label: 'Packages', href: '/crux/registry/packages/' },
  { label: 'Architecture', href: '/crux/design/architecture/' },
];
---

<header class="crux-header">
  <div class="crux-container header-inner">
    <div class="header-brand">
      <a href="/crux/" class="brand-link" aria-label="Crux Homepage">
        <Image src={cruxLogo} alt="Crux Logo" width={32} height={32} class="brand-logo" />
        <span class="brand-name">Crux</span>
      </a>
      <span class="version-badge">v0.2.1</span>
    </div>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" aria-label="Primary Navigation">
      <ul class="nav-list">
        {navLinks.map((link) => (
          <li>
            <a href={link.href} class="nav-link">{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Header Actions -->
    <div class="header-actions">
      <a
        href="https://github.com/ShaharyarShakir/crux"
        class="github-link"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Crux on GitHub"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
        </svg>
        <span class="github-text">GitHub</span>
      </a>

      <ThemeToggle />

      <!-- Mobile Hamburger Button -->
      <button
        id="mobile-menu-toggle"
        class="mobile-toggle"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
      >
        <svg class="menu-open-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <svg class="menu-close-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu-drawer" class="mobile-drawer" hidden>
    <div class="crux-container mobile-drawer-inner">
      <ul class="mobile-nav-list">
        {navLinks.map((link) => (
          <li>
            <a href={link.href} class="mobile-nav-link">{link.label}</a>
          </li>
        ))}
      </ul>
      <div class="mobile-drawer-footer">
        <a
          href="https://github.com/ShaharyarShakir/crux"
          class="crux-btn crux-btn-secondary"
          target="_blank"
          rel="noopener noreferrer"
        >
          View on GitHub
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  .crux-header {
    position: sticky;
    top: 0;
    z-index: 100;
    height: var(--crux-header-height);
    background-color: var(--crux-bg);
    border-bottom: 1px solid var(--crux-border);
    backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  .header-brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--crux-text-primary);
    text-decoration: none;
  }

  .brand-logo {
    display: block;
    width: 28px;
    height: 28px;
    object-fit: contain;
  }

  .brand-name {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--crux-text-primary);
  }

  .version-badge {
    font-family: var(--crux-font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    padding: 0.15rem 0.45rem;
    border-radius: var(--crux-radius-sm);
    background-color: var(--crux-accent-dim);
    color: var(--crux-accent);
    border: 1px solid var(--crux-accent-border);
  }

  .desktop-nav {
    display: flex;
    align-items: center;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--crux-text-secondary);
    transition: color 0.15s ease;
    padding: 0.25rem 0;
  }

  .nav-link:hover {
    color: var(--crux-accent);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .github-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--crux-text-secondary);
    padding: 0.4rem 0.6rem;
    border-radius: var(--crux-radius-sm);
    font-size: 0.875rem;
    font-weight: 500;
    transition: all 0.15s ease;
  }

  .github-link:hover {
    color: var(--crux-text-primary);
    background: var(--crux-surface);
  }

  .mobile-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: transparent;
    border: 1px solid var(--crux-border);
    border-radius: var(--crux-radius-sm);
    color: var(--crux-text-primary);
    cursor: pointer;
    padding: 0;
  }

  .menu-close-icon {
    display: none;
  }

  .mobile-toggle[aria-expanded="true"] .menu-open-icon {
    display: none;
  }

  .mobile-toggle[aria-expanded="true"] .menu-close-icon {
    display: block;
  }

  .mobile-drawer {
    position: absolute;
    top: var(--crux-header-height);
    left: 0;
    right: 0;
    background-color: var(--crux-bg);
    border-bottom: 1px solid var(--crux-border);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
  }

  .mobile-drawer-inner {
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
  }

  .mobile-nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .mobile-nav-link {
    display: block;
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--crux-text-primary);
    padding: 0.4rem 0;
  }

  .mobile-drawer-footer {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--crux-border);
  }

  @media (max-width: 860px) {
    .desktop-nav {
      display: none;
    }
    .github-text {
      display: none;
    }
    .mobile-toggle {
      display: inline-flex;
    }
  }
</style>

<script is:inline>
  (() => {
    const toggle = document.getElementById('mobile-menu-toggle');
    const drawer = document.getElementById('mobile-menu-drawer');
    if (!toggle || !drawer) return;

    toggle.addEventListener('click', () => {
      const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', !isExpanded ? 'true' : 'false');
      drawer.hidden = isExpanded;
    });
  })();
</script>
