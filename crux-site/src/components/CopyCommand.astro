---
// CopyCommand.astro — One-line copyable command with clipboard feedback
interface Props {
  command?: string;
  label?: string;
}

const {
  command = 'curl -fsSL https://raw.githubusercontent.com/ShaharyarShakir/crux/main/install/install.sh | bash',
  label = 'Install Crux'
} = Astro.props;
---

<div class="copy-command-container">
  <div class="copy-command-inner" role="region" aria-label={label}>
    <span class="prompt-symbol" aria-hidden="true">$</span>
    <code class="command-text">{command}</code>
    <button
      class="copy-btn"
      data-command={command}
      aria-label="Copy command to clipboard"
      type="button"
      title="Copy to clipboard"
    >
      <svg class="copy-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
      </svg>
      <svg class="check-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
      <span class="copy-feedback">Copied!</span>
    </button>
  </div>
</div>

<style>
  .copy-command-container {
    width: 100%;
    max-width: 640px;
  }

  .copy-command-inner {
    display: flex;
    align-items: center;
    background-color: var(--crux-terminal-bg);
    border: 1px solid var(--crux-border);
    border-radius: var(--crux-radius-md);
    padding: 0.75rem 1rem;
    gap: 0.75rem;
    transition: border-color 0.15s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
  }

  .copy-command-inner:hover {
    border-color: var(--crux-accent-border);
  }

  .prompt-symbol {
    font-family: var(--crux-font-mono);
    color: var(--crux-accent);
    font-weight: 700;
    user-select: none;
    font-size: 0.9375rem;
  }

  .command-text {
    flex: 1;
    font-family: var(--crux-font-mono);
    font-size: 0.875rem;
    color: var(--crux-text-primary);
    overflow-x: auto;
    white-space: nowrap;
    scrollbar-width: none;
  }

  .command-text::-webkit-scrollbar {
    display: none;
  }

  .copy-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--crux-surface);
    border: 1px solid var(--crux-border);
    border-radius: var(--crux-radius-sm);
    color: var(--crux-text-secondary);
    padding: 0.4rem;
    cursor: pointer;
    transition: all 0.15s ease;
    flex-shrink: 0;
  }

  .copy-btn:hover {
    color: var(--crux-accent);
    border-color: var(--crux-accent);
    background: var(--crux-surface-elevated);
  }

  .check-icon {
    display: none;
    color: #5BA882;
  }

  .copy-btn.copied .copy-icon {
    display: none;
  }

  .copy-btn.copied .check-icon {
    display: block;
  }

  .copy-feedback {
    position: absolute;
    bottom: calc(100% + 6px);
    right: 50%;
    transform: translateX(50%);
    background: var(--crux-surface-elevated);
    border: 1px solid var(--crux-border);
    color: var(--crux-text-primary);
    font-family: var(--crux-font-mono);
    font-size: 0.75rem;
    padding: 0.2rem 0.5rem;
    border-radius: var(--crux-radius-sm);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease;
    white-space: nowrap;
  }

  .copy-btn.copied .copy-feedback {
    opacity: 1;
  }
</style>

<script is:inline>
  (() => {
    document.querySelectorAll('.copy-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const cmd = btn.getAttribute('data-command');
        if (!cmd) return;

        try {
          await navigator.clipboard.writeText(cmd);
          btn.classList.add('copied');
          setTimeout(() => {
            btn.classList.remove('copied');
          }, 2000);
        } catch (err) {
          console.error('Failed to copy command:', err);
        }
      });
    });
  })();
</script>
